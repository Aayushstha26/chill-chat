// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No 'url' here — it's in prisma.config.ts now
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
}